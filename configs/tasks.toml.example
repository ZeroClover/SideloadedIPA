# ==============================================================================
# SideloadedIPA Task Configuration Reference
# ==============================================================================
# Define one or more signing tasks in the [[tasks]] array.

# Optional: Cloudflare R2 storage layout defaults
# [r2]
# key_prefix = "apps"              # Object key prefix for IPAs and icons
# apps_json_key = "site/apps.json" # Registry path read by the Next.js web front-end

# ------------------------------------------------------------------------------
# Example 1: Direct HTTPS Download (with pinned SHA-256)
# ------------------------------------------------------------------------------
[[tasks]]
# Unique identifier used for CLI commands and provisioning profile naming
task_name = "MyApp"

# Display name of the application
app_name = "MyApp"

# Target root bundle ID (must match an App ID in Apple Developer account)
bundle_id = "com.example.myapp"

# Direct HTTPS download URL of the unsigned IPA
ipa_url = "https://example.com/path/to/MyApp.ipa"

# Required SHA-256 checksum of the original IPA (shasum -a 256 MyApp.ipa)
ipa_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Optional: URL slug for R2 storage and web portal (defaults to sanitized app_name)
# slug = "myapp"

# Optional: Icon source ("ipa:", an HTTPS URL, or a repository path)
# icon_path = "ipa:"

# ------------------------------------------------------------------------------
# Example 2: Tracking GitHub Releases (Standard Release)
# ------------------------------------------------------------------------------
[[tasks]]
task_name = "AnotherApp"
app_name = "Another App"
bundle_id = "com.example.anotherapp"

# GitHub repository URL (mutually exclusive with ipa_url)
repo_url = "https://github.com/owner/repo"

# Filename pattern to match release assets (fnmatch glob syntax)
release_glob = "*.ipa"

# Set true to track pre-releases / betas, or false for stable releases only
use_prerelease = false

slug = "anotherapp"

# App icon path within the repository (fetched at the matching release tag)
icon_path = "ios/Runner/Assets.xcassets/AppIcon.appiconset/Icon-App-1024x1024@1x.png"

# ------------------------------------------------------------------------------
# Example 3: Tracking GitHub Releases with Specific Asset Glob & Pre-releases
# ------------------------------------------------------------------------------
[[tasks]]
task_name = "SpecialApp"
app_name = "Special App"
bundle_id = "com.example.specialapp"
repo_url = "https://github.com/specialorg/specialapp"
release_glob = "*universal*.ipa"
use_prerelease = true
slug = "specialapp"

# ------------------------------------------------------------------------------
# Example 4: Multi-Bundle Signing (LiveContainer with Extensions & App Groups)
# ------------------------------------------------------------------------------
[[tasks]]
task_name = "LiveContainer"
app_name = "LiveContainer"
bundle_id = "io.example.livecontainer"
repo_url = "https://github.com/LiveContainer/LiveContainer"
release_glob = "LiveContainer.ipa"
slug = "LiveContainer"
icon_path = "Resources/Assets.xcassets/AppIcon.appiconset/AppIcon1024.png"
publication_enabled = false

[tasks.signing.app_groups]
shared = "group.io.example.livecontainer"

# Main root application
[[tasks.signing.bundles]]
source_bundle_id = "com.kdt.livecontainer"
target_bundle_id = "io.example.livecontainer"
role = "root"
required_capabilities = ["APP_GROUPS", "HEALTHKIT", "INCREASED_MEMORY_LIMIT", "KEYCHAIN_SHARING", "CLINICAL_HEALTH_RECORDS", "HEALTHKIT_BACKGROUND_DELIVERY"]
entitlement_mode = "template"
entitlements_file = "configs/signing/livecontainer/root-process.plist"

# Helper process (LiveProcess)
[[tasks.signing.bundles]]
source_bundle_id = "com.kdt.livecontainer.LiveProcess"
required_capabilities = ["APP_GROUPS", "HEALTHKIT", "INCREASED_MEMORY_LIMIT", "KEYCHAIN_SHARING", "CLINICAL_HEALTH_RECORDS", "HEALTHKIT_BACKGROUND_DELIVERY"]
entitlement_mode = "template"
entitlements_file = "configs/signing/livecontainer/root-process.plist"

# Launch extension
[[tasks.signing.bundles]]
source_bundle_id = "com.kdt.livecontainer.LaunchAppExtension"
required_capabilities = ["APP_GROUPS"]
entitlement_mode = "profile"

# Share extension
[[tasks.signing.bundles]]
source_bundle_id = "com.kdt.livecontainer.ShareExtension"
required_capabilities = ["APP_GROUPS"]
entitlement_mode = "profile"

# Entitlement mode reference:
# - "profile": Uses entitlements granted directly by the provisioning profile.
# - "template": Renders a plist template under configs/signing/ with variable substitution.
# - "preserve-source": Preserves original source entitlements with updated Team & Group IDs.
